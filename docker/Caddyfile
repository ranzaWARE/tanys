{
	debug
}

# Certificato fisso caricato esplicitamente (generato in build, vedi
# Caddy.Dockerfile) — niente selezione automatica per SNI/hostname, quindi
# funziona anche per connessioni via IP senza SNI dietro il NAT di Docker.
# Se cambi server/IP, aggiorna il CN/SAN in Caddy.Dockerfile e rebuilda.
:443 {
	tls /etc/caddy/cert.pem /etc/caddy/key.pem

	encode gzip

	reverse_proxy web:3000

	log {
		output stdout
	}
}

:80 {
	redir https://{host}{uri} permanent
}
