# IP hardcoded invece che via $SITE_ADDRESS: la variabile d'ambiente non
# arrivava al container attraverso la catena Portainer -> interpolazione
# del compose (confermato dai log di debug: l'identificatore del
# certificato restava sempre l'IP interno del container Docker, mai
# quello impostato). Se cambi server/IP, modifica questa riga.
192.168.100.5 {
	tls internal

	encode gzip

	reverse_proxy web:3000

	log {
		output stdout
	}
}
