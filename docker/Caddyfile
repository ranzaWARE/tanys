{
	debug
}

# Se SITE_ADDRESS e' un dominio reale (es. video.tuodominio.it) e le porte
# 80/443 sono raggiungibili da internet, si puo' passare a un issuer ACME
# reale togliendo "tls internal". Con "tls internal" esplicito, Caddy usa
# sempre e comunque la sua CA interna (self-signed) — anche per connessioni
# dirette via IP senza SNI, che con la rilevazione automatica implicita
# risultavano in un errore di handshake TLS.
{$SITE_ADDRESS::443} {
	tls internal

	encode gzip

	reverse_proxy web:3000

	log {
		output stdout
	}
}
